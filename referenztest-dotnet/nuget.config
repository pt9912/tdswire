<?xml version="1.0" encoding="utf-8"?>
<!-- Genau eine Quelle: <clear /> verwirft jede Quelle aus Benutzer- und Maschinenkonfiguration,
     packageSourceMapping bindet jedes Paket an nuget.org (ADR-0008, TDS-QA-06). Eine zweite Quelle
     braucht einen eigenen Eintrag samt Mapping in dieser Datei.
     Signaturpruefung: signatureValidationMode=require verlangt von jedem Paket eine Signatur, die
     trustedSigners nennt. Die Liste fuehrt die Zertifikate (SHA-256) der 36 Pakete aus
     packages.lock.json, gelesen mit `dotnet nuget verify` mit dem Schalter all (Messung im Slice
     slice-qa-dotnet-lieferkette-haerten): fuenf Autorenzertifikate (drei Microsoft, zwei xUnit.net)
     und drei Repository-Zertifikate von nuget.org. Ein neues oder aktualisiertes Paket mit anderem
     Zertifikat bricht den Restore und verlangt einen Eintrag hier. Zertifikate
     laufen ab; was ein abgelaufenes Zertifikat im Restore bewirkt, ist nicht gemessen.
     Gemessen ist auch: packages.lock.json und contentHash schlagen bei veraenderten Paketen fehl
     (NU1403, NU1004). -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
  <config>
    <add key="signatureValidationMode" value="require" />
  </config>
  <trustedSigners>
    <author name="microsoft">
      <certificate fingerprint="566A31882BE208BE4422F7CFD66ED09F5D4524A5994F50CCC8B05EC0528C1353" hashAlgorithm="SHA256" allowUntrustedRoot="false" />
      <certificate fingerprint="9A1B131BEE0605433056A4EA3815478A8E177961A968C6C0027C1093D1FEB630" hashAlgorithm="SHA256" allowUntrustedRoot="false" />
      <certificate fingerprint="AA12DA22A49BCE7D5C1AE64CC1F3D892F150DA76140F210ABD2CBFFCA2C18A27" hashAlgorithm="SHA256" allowUntrustedRoot="false" />
    </author>
    <author name="xunit">
      <certificate fingerprint="B8F6A977E333577BC4DA250BDB42B08171EB3C814E6502A7D5393828D8813DFE" hashAlgorithm="SHA256" allowUntrustedRoot="false" />
      <certificate fingerprint="0D7662406AABB78B853A1901343BF9F7757492B785402172C5962D8204408161" hashAlgorithm="SHA256" allowUntrustedRoot="false" />
    </author>
    <repository name="nuget.org" serviceIndex="https://api.nuget.org/v3/index.json">
      <certificate fingerprint="1F4B311D9ACC115C8DC8018B5A49E00FCE6DA8E2855F9F014CA6F34570BC482D" hashAlgorithm="SHA256" allowUntrustedRoot="false" />
      <certificate fingerprint="0E5F38F57DC1BCC806D8494F4F90FBCEDD988B46760709CBEEC6F4219AA6157D" hashAlgorithm="SHA256" allowUntrustedRoot="false" />
      <certificate fingerprint="5A2901D6ADA3D18260B9C6DFE2133C95D74B9EEF6AE0E5DC334C8454D1477DF4" hashAlgorithm="SHA256" allowUntrustedRoot="false" />
    </repository>
  </trustedSigners>
</configuration>
