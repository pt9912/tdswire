<?xml version="1.0" encoding="utf-8"?>
<!-- Genau eine Quelle: <clear /> verwirft jede Quelle aus Benutzer- und Maschinenkonfiguration,
     packageSourceMapping bindet jedes Paket an nuget.org (ADR-0008, TDS-QA-06). Eine zweite Quelle
     braucht einen eigenen Eintrag samt Mapping in dieser Datei. Weder trustedSigners noch
     signatureValidationMode sind gesetzt: die Integritaet nach dem ersten Lock tragen allein
     packages.lock.json und contentHash (CO-002). -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
